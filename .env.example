# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used by Prisma migrations.
# Vercel's Neon integration may name this DATABASE_URL_UNPOOLED instead.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Judge0 compiler API.
# For Judge0 CE/self-hosted, use JUDGE0_API_KEY only when your server requires X-Auth-Token.
# For RapidAPI Judge0, set JUDGE0_API_URL, JUDGE0_API_KEY, and JUDGE0_RAPIDAPI_HOST.
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
JUDGE0_RAPIDAPI_HOST=""

# Admin-only content manager.
# Use a strong password and a long random secret in production.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
